# =====================================================================
# EJEMPLO DE ARCHIVO .ENV PARA FILITOUR
# Copia este archivo a .env y ajusta los valores en tu VPS
# =====================================================================

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=filitour_db
DB_USER=root
# IMPORTANTE: En producción, NUNCA guardes contraseñas en este archivo.
# Usa Docker Secrets o variables de entorno del sistema.
# DB_PASS=<tu_contraseña_segura_generada>

# Security Notes:
# 1. Cambia la contraseña del admin después del primer login
# 2. Genera una contraseña fuerte para la base de datos (mínimo 32 caracteres)
# 3. En el VPS, exporta DB_PASS como variable de entorno antes de docker-compose up
